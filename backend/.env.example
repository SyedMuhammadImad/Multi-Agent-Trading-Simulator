APP_ENV=development
CONTROL_TOKEN=

TRADING_MODE=paper
INITIAL_CAPITAL=100000
MAX_PORTFOLIO_RISK_PCT=0.02
MAX_DAILY_LOSS_PCT=0.05
MAX_DRAWDOWN_PCT=0.15

LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000

NEWS_API_KEY=

# Optional Exness MT5 demo link.
# Demo trading is OFF unless TRADING_MODE=exness_demo and EXNESS_ENABLE_DEMO_TRADING=true.
# Install MetaTrader5 locally, open Exness MT5, then set these in backend/.env.
BROKER=exness_mt5
EXNESS_DEMO_LOGIN=
EXNESS_DEMO_PASSWORD=
EXNESS_DEMO_SERVER=
EXNESS_MT5_PATH=
EXNESS_SYMBOLS=XAUUSDm,EURUSDm,BTCUSDm,USOILm
EXNESS_TRADE_SYMBOLS=EURUSDm
EXNESS_SYMBOL_MAP=BTC-USD:BTCUSDm,ETH-USD:ETHUSDm,EUR-USD:EURUSDm,GBP-USD:GBPUSDm,XAUUSD:XAUUSDm,USOIL:USOILm,WTI:USOILm,XAUUSDm:XAUUSDm,EURUSDm:EURUSDm,BTCUSDm:BTCUSDm,USOILm:USOILm
EXNESS_ENABLE_DEMO_TRADING=false
EXNESS_ALLOW_MIN_VOLUME_ROUND_UP=false
EXNESS_MAX_ORDER_VOLUME=0.01
EXNESS_MAX_ORDER_RISK_USD=2.0
EXNESS_DEVIATION_POINTS=20
EXNESS_MARKET_DATA_INTERVAL=2.0
