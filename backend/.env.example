APP_ENV=development
CONTROL_TOKEN=

TRADING_MODE=paper
INITIAL_CAPITAL=100000
MAX_PORTFOLIO_RISK_PCT=0.02
MAX_DAILY_LOSS_PCT=0.05
MAX_DRAWDOWN_PCT=0.15

LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000

NEWS_API_KEY=

# Optional Exness MT5 demo read-only link.
# Install MetaTrader5 locally, open Exness MT5, then set these in backend/.env.
BROKER=exness_mt5
EXNESS_DEMO_LOGIN=
EXNESS_DEMO_PASSWORD=
EXNESS_DEMO_SERVER=
EXNESS_MT5_PATH=
EXNESS_SYMBOLS=XAUUSDm,EURUSDm,BTCUSDm
